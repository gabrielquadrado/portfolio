{
  "name": "portfolio",
  "version": "1.0.0",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./styles/styles.css",
    "watch": "tailwindcss -i ./src/input.css -o ./styles/styles.css --watch",
    "dev": "npx concurrently \"npm run watch\" \"npx live-server --port=3000 --open=index.html\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "live-server": "^1.2.2",
    "tailwindcss": "^3.4.17"
  }
}
